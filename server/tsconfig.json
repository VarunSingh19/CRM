{
  // TypeScript 7 (native compiler). `baseUrl` and `moduleResolution: node` were
  // removed in 7.0 — do not add them back. Imports use explicit `.js` suffixes
  // because this is native ESM run by Node, not a bundler.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["src"]
}
