# Copy to .env and fill in. Every variable is validated by src/config/env/env.ts:
# the process refuses to boot if a value is missing or malformed.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Browser origins allowed to make credentialed requests (CORS) and to send
# state-changing requests at all (cross-site request forgery check).
# Required in production.
ALLOWED_ORIGINS=http://localhost:3000

# Number of reverse-proxy hops in front of Express (0 = none). Set it to the
# real count so req.ip is the client's address; the rate limit depends on it.
TRUST_PROXY=0

# Per client address: failed requests allowed in the window before the
# address is told to wait.
RATE_LIMIT_IP_WINDOW_MS=300000
RATE_LIMIT_IP_MAX=300

# After SIGTERM, keep serving this long while /ready answers 503, so a load
# balancer stops routing here first. 0 = close at once.
SHUTDOWN_DELAY_MS=0

# Swagger UI at /api-docs. Defaults to on in development and off in
# production, where published API docs are a map for attackers.
# SWAGGER_ENABLED=true

# ---------------------------------------------------------------- custom header
# Every /api request must send this header with this value (health probes
# don't). Generate the value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Set CUSTOM_HEADER_ENABLED=false to bypass the check (e.g. local development).
CUSTOM_HEADER_ENABLED=true
CUSTOM_HEADER_NAME=x-api-key
CUSTOM_HEADER_VALUE=

# ---------------------------------------------------------------- database
# Local mongod (no TLS):         mongodb://127.0.0.1:27017/onference_crm
# Atlas (TLS is automatic):      mongodb+srv://cluster0.xxxxx.mongodb.net/onference_crm?authSource=admin
# Self-hosted with TLS:          mongodb://db1.internal:27017,db2.internal:27017/onference_crm?replicaSet=rs0
# Never add tlsInsecure / tlsAllowInvalidCertificates / tlsAllowInvalidHostnames:
# the server refuses to start with them. For a private CA use MONGODB_TLS_CA_FILE.
MONGODB_URI=mongodb://127.0.0.1:27017/onference_crm

# Credentials, kept out of the URI so a secret store can inject them and
# special characters need no escaping. Required in production (or X.509).
# MONGODB_USERNAME=crm_api
# MONGODB_PASSWORD=

# Encryption in transit. Always on in production; on for mongodb+srv:// URIs.
# MONGODB_TLS=true
# CA certificate (PEM) that signed the database's certificate, for a private CA.
# MONGODB_TLS_CA_FILE=/run/secrets/mongo-ca.pem
# This app's client certificate + key (PEM), when the database requires mutual
# TLS, or for X.509 sign-in (then add authMechanism=MONGODB-X509 to the URI).
# MONGODB_TLS_CERT_KEY_FILE=/run/secrets/mongo-client.pem
# MONGODB_TLS_CERT_KEY_PASSWORD=

# Connection pool, per API process.
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
MONGODB_APP_NAME=onference-crm-api

# ---------------------------------------------------------------- email (SMTP)
# Amazon SES over SMTP. Required in production. In development, leave
# SMTP_HOST, SMTP_USER, SMTP_PASS and FROM_EMAIL empty to switch email off
# (emails are skipped with a log line).
# Always encrypted: port 465 is TLS from the first byte; any other port
# (587, 2587) must upgrade with STARTTLS or nothing is sent. Certificates
# are always verified.
# SES in us-east-1: email-smtp.us-east-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=465
# Only for an unusual port: true = TLS from the first byte, false = STARTTLS.
# SMTP_SECURE=true
# SES SMTP credentials (SES console → SMTP settings), not the AWS access keys.
SMTP_USER=
SMTP_PASS=
# The sender of every email; must be a verified identity in SES.
# "support@onference.in" or "Onference CRM <support@onference.in>".
FROM_EMAIL=
# Emails per second this process may send: the SES account's maximum send
# rate divided by the number of API processes. Defaults to 1 (SES sandbox).
SES_RATE_PER_SEC=1
