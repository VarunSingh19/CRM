{
  "name": "onference-crm-api",
  "version": "0.1.0",
  "private": true,
  "description": "Setup skeleton for the Onference CRM API: config, security middlewares, database and email connections, health probes and Swagger docs.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/docs', 'dist/docs', { recursive: true })\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "mongoose": "9.10.2",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
